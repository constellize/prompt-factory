{
  "name": "prompt-factory",
  "version": "0.3.1",
  "description": "Source of truth for Constellize prompts and personas - generates book, website, and Claude Code marketplace outputs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-prompt": "./bin/create-prompt"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "validate": "node dist/validate.js",
    "deploy": "node dist/deploy.js",
    "create-prompt": "./bin/create-prompt",
    "generate:website": "npx ts-node build/generate-website.ts",
    "generate:marketplace": "npx ts-node build/generate-marketplace.ts",
    "generate:all": "npm run generate:website && npm run generate:marketplace && npm run generate:book",
    "validate:book": "npx ts-node build/validate-book-refs.ts",
    "validate:chain": "npx ts-node build/validate-full-chain.ts",
    "generate:book": "npx ts-node build/generate-book.ts",
    "migrate:book-refs": "npx ts-node build/migrate-book-refs.ts",
    "migrate:prompts": "npx ts-node build/migrate-prompts.ts",
    "migrate:personas": "npx ts-node build/migrate-personas.ts"
  },
  "keywords": [
    "prompts",
    "ai",
    "llm",
    "claude",
    "context-engineering",
    "books"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.10",
    "yaml": "^2.8.2"
  }
}
