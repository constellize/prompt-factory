# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist/

# Ignore compiled JS but keep build scripts (TypeScript)
*.js
!build/**/*.ts
*.js.map
*.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/

# Environment
.env
.env.local
.env.*.local

# Temporary files
tmp/
temp/
*.tmp

# Output (keep structure, ignore generated content)
output/constellize/**/*
!output/constellize/.gitkeep

# Extracted content
content/extracted/**/*
!content/extracted/.gitkeep

# Logs
logs/
*.log

# TypeScript
*.tsbuildinfo
